<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/widget_event_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/widget_primary" android:ellipsize="end" android:textStyle="bold" android:maxLines="2" android:text="" />
    <TextView android:id="@+id/widget_event_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_primary" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" android:text="" />
    <TextView android:id="@+id/widget_event_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:visibility="gone" android:text="" />
</LinearLayout>