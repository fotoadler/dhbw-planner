<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/schedule_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="25sp" android:textColor="@color/widget_accent" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:fontFamily="sans-serif-rounded" android:text="" />
        <TextView android:id="@+id/widget_month" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:text="" />
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_calendar" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:letterSpacing="0.08" android:layout_marginBottom="5dp" android:text="" />
        <LinearLayout android:id="@+id/widget_events" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/widget_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="23sp" android:textColor="@color/widget_primary" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:fontFamily="sans-serif-rounded" android:maxWidth="250dp" android:text="" />
        <TextView android:id="@+id/widget_empty_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" android:text="" />
        <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="9dp" android:textStyle="bold" android:text="" />
    </LinearLayout>
    <LinearLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <TextView android:id="@+id/widget_course" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:text="" />
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end" android:text="" />
</LinearLayout>